{
  "name": "InstitutionProgram",
  "type": "object",
  "properties": {
    "institution_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05de\u05d5\u05e1\u05d3 \u05d4\u05d7\u05d9\u05e0\u05d5\u05da (EducationInstitution.id)"
    },
    "program_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05ea\u05d5\u05db\u05e0\u05d9\u05ea/\u05e1\u05d9\u05dc\u05d1\u05d5\u05e1 (Syllabus.id)"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05ea\u05d7\u05dc\u05ea \u05d4\u05ea\u05d5\u05db\u05e0\u05d9\u05ea \u05d1\u05de\u05d5\u05e1\u05d3"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05e1\u05d9\u05d5\u05dd \u05d4\u05ea\u05d5\u05db\u05e0\u05d9\u05ea \u05d1\u05de\u05d5\u05e1\u05d3"
    },
    "status": {
      "type": "string",
      "enum": [
        "\u05e4\u05e2\u05d9\u05dc\u05d4",
        "\u05dc\u05d0 \u05e4\u05e2\u05d9\u05dc\u05d4",
        "\u05de\u05d3\u05e3"
      ],
      "default": "\u05e4\u05e2\u05d9\u05dc\u05d4",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05ea\u05d5\u05db\u05e0\u05d9\u05ea \u05d1\u05de\u05d5\u05e1\u05d3"
    },
    "assigned_device_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05e8\u05e9\u05d9\u05de\u05ea \u05de\u05d6\u05d4\u05d9 \u05d4\u05de\u05e9\u05e7\u05e4\u05d5\u05ea \u05d4\u05de\u05e9\u05d5\u05d9\u05db\u05d5\u05ea \u05dc\u05ea\u05d5\u05db\u05e0\u05d9\u05ea \u05d6\u05d5 (VRDevice.id)"
    },
    "notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea \u05e0\u05d5\u05e1\u05e4\u05d5\u05ea \u05dc\u05d2\u05d1\u05d9 \u05d4\u05e9\u05d9\u05d5\u05da"
    }
  },
  "required": [
    "institution_id",
    "program_id"
  ]
}