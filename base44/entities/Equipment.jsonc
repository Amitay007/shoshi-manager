    },
    "type": {
      "type": "string",
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05e6\u05d9\u05d5\u05d3"
    },
    "serial_number": {
      "type": "string",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05e1\u05d9\u05d3\u05d5\u05e8\u05d9"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "faulty",
        "maintenance"
