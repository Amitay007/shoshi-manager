{
  "name": "ReportedHours",
  "type": "object",
  "properties": {
    "teacher_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05de\u05d5\u05e8\u05d4 \u05d4\u05de\u05d3\u05d5\u05d5\u05d7"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05d3\u05d9\u05d5\u05d5\u05d7"
    },
    "hours_amount": {
      "type": "number",
      "description": "\u05db\u05de\u05d5\u05ea \u05d4\u05e9\u05e2\u05d5\u05ea"
    },
    "description": {
      "type": "string",
      "description": "\u05ea\u05d9\u05d0\u05d5\u05e8 \u05d4\u05e4\u05e2\u05d9\u05dc\u05d5\u05ea (\u05d0\u05d5\u05e4\u05e6\u05d9\u05d5\u05e0\u05dc\u05d9)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "verified",
        "disputed"
      ],
      "default": "pending",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05d3\u05d9\u05d5\u05d5\u05d7"
    },
    "employee_verified": {
      "type": "string",
      "enum": [
        "verified",
        "rejected",
        "pending"
      ],
      "default": "pending",
      "description": "\u05d4\u05d0\u05dd \u05d4\u05e2\u05d5\u05d1\u05d3 \u05d0\u05d9\u05e9\u05e8 \u05d0\u05ea \u05d4\u05e8\u05e9\u05d5\u05de\u05d4 (V/X)"
    },
    "is_manual": {
      "type": "boolean",
      "default": true,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05d5\u05d6\u05df \u05d9\u05d3\u05e0\u05d9\u05ea \u05e2\"\u05d9 \u05d4\u05e2\u05d5\u05d1\u05d3"
    }
  },
  "required": [
    "teacher_id",
    "date",
    "hours_amount"
  ]
}