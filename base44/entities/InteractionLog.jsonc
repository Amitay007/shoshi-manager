{
  "name": "InteractionLog",
  "type": "object",
  "properties": {
    "contact_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d0\u05d9\u05e9 \u05d4\u05e7\u05e9\u05e8"
    },
    "date": {
      "type": "string",
      "format": "date-time",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d5\u05e9\u05e2\u05ea \u05d4\u05d0\u05d9\u05e0\u05d8\u05e8\u05d0\u05e7\u05e6\u05d9\u05d4"
    },
    "type": {
      "type": "string",
      "enum": [
        "call",
        "whatsapp",
        "meeting",
        "video",
        "note"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05d0\u05d9\u05e0\u05d8\u05e8\u05d0\u05e7\u05e6\u05d9\u05d4"
    },
    "content": {
      "type": "string",
      "description": "\u05e1\u05d9\u05db\u05d5\u05dd \u05d3\u05d1\u05e8\u05d9\u05dd"
    },
    "follow_up_date": {
      "type": "string",
      "format": "date-time",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d4\u05de\u05e9\u05da"
    },
    "status": {
      "type": "string",
      "enum": [
        "done",
        "open"
      ],
      "default": "done",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05de\u05e9\u05d9\u05de\u05d4"
    }
  },
  "required": [
    "contact_id",
    "date",
    "type"
  ]
}