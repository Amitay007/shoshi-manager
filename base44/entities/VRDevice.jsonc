{
  "name": "VRDevice",
  "type": "object",
  "properties": {
    "device_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05db\u05e9\u05d9\u05e8/\u05db\u05d9\u05e0\u05d5\u05d9"
    },
    "binocular_number": {
      "type": "number",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d4\u05de\u05e9\u05e7\u05e4\u05ea"
    },
    "serial_number": {
      "type": "string",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05e1\u05d9\u05d3\u05d5\u05e8\u05d9"
    },
    "headset_type": {
      "type": "string",
      "enum": [
        "Meta Quest 2",
        "Meta Quest 3",
        "Meta Quest 3s",
        "\u05d0\u05d7\u05e8"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05de\u05e9\u05e7\u05e4\u05ea"
    },
    "model": {
      "type": "string",
      "description": "\u05d3\u05d2\u05dd \u05d4\u05de\u05db\u05e9\u05d9\u05e8 (\u05db\u05ea\u05d9\u05d1\u05d4 \u05d7\u05d5\u05e4\u05e9\u05d9\u05ea)"
    },
    "usage_role": {
      "type": "string",
      "enum": [
        "\u05ea\u05dc\u05de\u05d9\u05d3",
        "\u05de\u05d5\u05e8\u05d4"
      ],
      "description": "\u05de\u05e6\u05d1/\u05d9\u05d9\u05e2\u05d5\u05d3 \u05d4\u05de\u05e9\u05e7\u05e4\u05ea"
    },
    "purchase_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05e8\u05db\u05d9\u05e9\u05d4"
    },
    "primary_email": {
      "type": "string",
      "description": "\u05db\u05ea\u05d5\u05d1\u05ea \u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05e8\u05d0\u05e9\u05d9\u05ea (Gmail)"
    },
    "price": {
      "type": "number",
      "description": "\u05de\u05d7\u05d9\u05e8 \u05d4\u05de\u05db\u05e9\u05d9\u05e8"
    },
    "status": {
      "type": "string",
      "enum": [
        "\u05d6\u05de\u05d9\u05df",
        "\u05d1\u05e9\u05d9\u05de\u05d5\u05e9",
        "\u05d1\u05ea\u05d9\u05e7\u05d5\u05df",
        "\u05de\u05d5\u05e9\u05d1\u05ea"
      ],
      "default": "\u05d6\u05de\u05d9\u05df",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05de\u05db\u05e9\u05d9\u05e8"
    },
    "current_status": {
      "type": "string",
      "enum": [
        "\u05d6\u05de\u05d9\u05df",
        "\u05d1\u05e9\u05d9\u05de\u05d5\u05e9",
        "\u05d1\u05ea\u05d7\u05d6\u05d5\u05e7\u05d4",
        "\u05de\u05d5\u05e9\u05d1\u05ea"
      ],
      "default": "\u05d6\u05de\u05d9\u05df",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05e0\u05d5\u05db\u05d7\u05d9 \u05d1\u05d6\u05de\u05df \u05d0\u05de\u05ea"
    },
    "is_disabled": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05de\u05e9\u05e7\u05e4\u05ea \u05de\u05d5\u05e9\u05d1\u05ea\u05ea"
    },
    "disable_reason": {
      "type": "string",
      "description": "\u05e1\u05d9\u05d1\u05ea \u05d4\u05e9\u05d1\u05ea\u05ea \u05d4\u05de\u05e9\u05e7\u05e4\u05ea"
    },
    "location": {
      "type": "string",
      "description": "\u05de\u05d9\u05e7\u05d5\u05dd \u05d4\u05de\u05db\u05e9\u05d9\u05e8"
    },
    "last_known_location": {
      "type": "string",
      "description": "\u05de\u05d9\u05e7\u05d5\u05dd \u05d0\u05d7\u05e8\u05d5\u05df \u05d9\u05d3\u05d5\u05e2"
    },
    "school": {
      "type": "string",
      "description": "\u05d1\u05d9\u05ea \u05e1\u05e4\u05e8"
    },
    "class": {
      "type": "string",
      "description": "\u05db\u05d9\u05ea\u05d4"
    },
    "project": {
      "type": "string",
      "description": "\u05e4\u05e8\u05d5\u05d9\u05e7\u05d8"
    },
    "notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea \u05e0\u05d5\u05e1\u05e4\u05d5\u05ea"
    },
    "assigned_to": {
      "type": "string",
      "description": "\u05de\u05e9\u05d5\u05d9\u05da \u05dc\u05e2\u05d5\u05d1\u05d3 (Teacher.id)"
    },
    "installedApps": {
      "type": "array",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05d0\u05e4\u05dc\u05d9\u05e7\u05e6\u05d9\u05d5\u05ea \u05d4\u05de\u05d5\u05ea\u05e7\u05e0\u05d5\u05ea (VRApp ids)",
      "items": {
        "type": "string"
      }
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "device_name",
    "binocular_number"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}