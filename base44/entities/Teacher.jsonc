{
  "name": "Teacher",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05de\u05dc\u05d0 \u05e9\u05dc \u05d4\u05de\u05d5\u05e8\u05d4"
    },
    "email": {
      "type": "string",
      "description": "\u05db\u05ea\u05d5\u05d1\u05ea \u05d0\u05d9\u05de\u05d9\u05d9\u05dc"
    },
    "phone": {
      "type": "string",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d8\u05dc\u05e4\u05d5\u05df"
    },
    "institution_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05de\u05d5\u05e1\u05d3 \u05d4\u05d7\u05d9\u05e0\u05d5\u05da (EducationInstitution.id)"
    },
    "subjects": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05de\u05e7\u05e6\u05d5\u05e2\u05d5\u05ea \u05d4\u05d5\u05e8\u05d0\u05d4"
    },
    "specialty": {
      "type": "string",
      "description": "\u05d4\u05ea\u05de\u05d7\u05d5\u05ea"
    },
    "experience_years": {
      "type": "number",
      "description": "\u05e9\u05e0\u05d5\u05ea \u05e0\u05d9\u05e1\u05d9\u05d5\u05df"
    },
    "hourlyRate": {
      "type": "number",
      "description": "\u05e9\u05db\u05e8 \u05e9\u05e2\u05ea\u05d9 \u05e9\u05dc \u05d4\u05de\u05d5\u05e8\u05d4",
      "default": 0
    },
    "job_title": {
      "type": "string",
      "description": "\u05ea\u05e4\u05e7\u05d9\u05d3 (\u05d8\u05e7\u05e1\u05d8 \u05d7\u05d5\u05e4\u05e9\u05d9)"
    },
    "start_work_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05ea\u05d7\u05dc\u05ea \u05e2\u05d1\u05d5\u05d3\u05d4"
    },
    "end_work_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05e1\u05d9\u05d5\u05dd \u05e2\u05d1\u05d5\u05d3\u05d4"
    },
    "cv_url": {
      "type": "string",
      "description": "\u05e7\u05d9\u05e9\u05d5\u05e8 \u05dc\u05e7\u05d5\u05e8\u05d5\u05ea \u05d7\u05d9\u05d9\u05dd"
    },
    "management_notes": {
      "type": "string",
      "description": "\u05d9\u05d5\u05de\u05df \u05de\u05e2\u05e7\u05d1 / \u05d4\u05e2\u05e8\u05d5\u05ea \u05de\u05e0\u05d4\u05dc"
    },
    "notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea \u05db\u05dc\u05dc\u05d9\u05d5\u05ea"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05de\u05d5\u05e8\u05d4 \u05e4\u05e2\u05d9\u05dc"
    }
  },
  "required": [
    "name",
    "phone",
    "job_title"
  ]
}