{
  "name": "DeviceApp",
  "type": "object",
  "properties": {
    "device_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05de\u05db\u05e9\u05d9\u05e8"
    },
    "app_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05d0\u05e4\u05dc\u05d9\u05e7\u05e6\u05d9\u05d4"
    },
    "installation_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05ea\u05e7\u05e0\u05d4"
    },
    "version": {
      "type": "string",
      "description": "\u05d2\u05e8\u05e1\u05ea \u05d4\u05d0\u05e4\u05dc\u05d9\u05e7\u05e6\u05d9\u05d4"
    },
    "usage_frequency": {
      "type": "string",
      "enum": [
        "\u05d2\u05d1\u05d5\u05d4",
        "\u05d1\u05d9\u05e0\u05d5\u05e0\u05d9",
        "\u05e0\u05de\u05d5\u05da",
        "\u05dc\u05d0 \u05d1\u05e9\u05d9\u05de\u05d5\u05e9"
      ],
      "description": "\u05ea\u05d3\u05d9\u05e8\u05d5\u05ea \u05e9\u05d9\u05de\u05d5\u05e9"
    },
    "last_used": {
      "type": "string",
      "format": "date",
      "description": "\u05e9\u05d9\u05de\u05d5\u05e9 \u05d0\u05d7\u05e8\u05d5\u05df"
    }
  },
  "required": [
    "device_id",
    "app_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}